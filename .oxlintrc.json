{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "off",
    "perf": "error",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    "no-underscore-dangle": "off"
  },
  "ignorePatterns": ["dist"]
}
